---
import { t, getLocalePath, withSlash, type Lang } from '../i18n/translations';
import { products } from '../data/products';

interface Props {
  lang?: Lang;
}

const { lang = 'tr' } = Astro.props;
const l = (map: Record<string, string>) => map[lang] || map['en'] || '';
const year = new Date().getFullYear();

// Tüm iç href'ler withSlash() üzerinden geçer — SEO_STANDARD trailing slash kuralı.
const quickLinksMap: Record<string, { key: string; href: string }[]> = {
  tr: [
    { key: 'nav.about', href: withSlash('/kurumsal') },
    { key: 'nav.products', href: withSlash('/urunler') },
    { key: 'nav.machines', href: withSlash('/makina-parkimiz') },
    { key: 'nav.references', href: withSlash('/referanslar') },
    { key: 'nav.certificates', href: withSlash('/belgeler') },
    { key: 'nav.contact', href: withSlash('/iletisim') },
    { key: 'nav.hr', href: withSlash('/insan-kaynaklari') },
  ],
  en: [
    { key: 'nav.about', href: withSlash('/en/about') },
    { key: 'nav.products', href: withSlash('/en/products') },
    { key: 'nav.machines', href: withSlash('/en/machines') },
    { key: 'nav.references', href: withSlash('/en/references') },
    { key: 'nav.certificates', href: withSlash('/en/certificates') },
    { key: 'nav.contact', href: withSlash('/en/contact') },
    { key: 'nav.hr', href: withSlash('/en/careers') },
  ],
  de: [
    { key: 'nav.about', href: withSlash('/de/about') },
    { key: 'nav.products', href: withSlash('/de/products') },
    { key: 'nav.machines', href: withSlash('/de/machines') },
    { key: 'nav.references', href: withSlash('/de/references') },
    { key: 'nav.certificates', href: withSlash('/de/certificates') },
    { key: 'nav.contact', href: withSlash('/de/contact') },
    { key: 'nav.hr', href: withSlash('/de/careers') },
  ],
  ar: [
    { key: 'nav.about', href: withSlash('/ar/about') },
    { key: 'nav.products', href: withSlash('/ar/products') },
    { key: 'nav.machines', href: withSlash('/ar/machines') },
    { key: 'nav.references', href: withSlash('/ar/references') },
    { key: 'nav.certificates', href: withSlash('/ar/certificates') },
    { key: 'nav.contact', href: withSlash('/ar/contact') },
    { key: 'nav.hr', href: withSlash('/ar/careers') },
  ],
};
const quickLinks = quickLinksMap[lang] ?? quickLinksMap['en'];

const productBasePath = l({ tr: '/urunler', en: '/en/products', de: '/de/products', ar: '/ar/products' });
const productLinks = products.map((product) => ({
  href: withSlash(`${productBasePath}/${product.slug}`),
  label: product.name[lang] ?? product.name.en,
}));
// Footer rozetleri: ikon yolu ile etiket dışında her rozet aynı kalıptan üretilir.
const KALKAN =
  'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z';
const MONITOR =
  'M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z';
const VERITABANI =
  'M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4';

const rozetler = [
  { ikon: KALKAN, etiket: 'AS9100 Certified' },
  { ikon: KALKAN, etiket: 'EYDEP B' },
  { ikon: KALKAN, etiket: 'ISO 9001' },
  { ikon: MONITOR, etiket: 'MES System' },
  { ikon: VERITABANI, etiket: 'ERP System' },
];
---

<footer class="bg-primary-dark">
  <div class="container-custom py-16 lg:py-20">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-12 gap-10 lg:gap-8">
      <!-- Brand -->
      <div class="lg:col-span-4">
        <a href={getLocalePath(lang, '/')} class="flex items-center gap-3 mb-6">
          <img src="/images/logo-stacked-white.png" alt="MKT Makina — Precision to Flight" width="404" height="114" class="h-14 w-auto" />
        </a>
        <p class="text-white/40 text-sm leading-relaxed mb-6 max-w-xs">
          {l({
            tr: 'Havacılık, savunma ve otomotiv sanayii için yüksek kaliteli hassas işleme, ölçüm ve enjeksiyon çözümleri.',
            en: 'High quality precision machining, measurement and injection solutions for aerospace, defense and automotive industries.',
            de: 'Hochwertige Präzisionsbearbeitungs-, Mess- und Spritzgusslösungen für Luftfahrt, Verteidigung und Automobilindustrie.',
            ar: 'حلول تشغيل وقياس وحقن عالية الجودة لقطاعات الطيران والدفاع والسيارات.',
          })}
        </p>
        <div class="flex flex-wrap gap-2">
          {rozetler.map((rozet) => (
            <div class="inline-flex items-center gap-2 px-3 py-2 bg-white/[0.04] border border-white/[0.06] text-xs text-white/60">
              <svg class="w-4 h-4 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d={rozet.ikon} />
              </svg>
              {rozet.etiket}
            </div>
          ))}
        </div>
      </div>

      <!-- Quick Links (başlıksız) -->
      <div class="lg:col-span-2">
        <ul class="space-y-2.5 lg:pt-2">
          {quickLinks.map((item) => (
            <li>
              <a href={item.href} class="text-white/50 text-sm hover:text-accent transition-colors">{t(lang, item.key)}</a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Products (başlıksız) -->
      <div class="lg:col-span-2">
        <ul class="space-y-2.5 lg:pt-2">
          {productLinks.map((item) => (
            <li>
              <a href={item.href} class="text-white/50 text-sm hover:text-accent transition-colors">{item.label}</a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Contact (başlıksız) -->
      <div class="lg:col-span-4">
        <address class="not-italic space-y-4 text-sm text-white/50 lg:pt-2">
          <div class="flex gap-3">
            <svg class="w-4 h-4 text-accent shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
            <a href="https://www.google.com/maps/search/?api=1&query=40.7257778,30.3876111" target="_blank" rel="noopener noreferrer" class="hover:text-accent transition-colors">{t(lang, 'footer.address')}</a>
          </div>
          <div class="flex gap-3">
            <svg class="w-4 h-4 text-accent shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
            <div>
              <a href="tel:+902642761880" class="hover:text-accent transition-colors block">+90 264 276 18 80</a>
              <span class="numara-ltr text-white/20 text-xs">Fax: +90 264 276 18 77</span>
            </div>
          </div>
          <div class="flex gap-3">
            <svg class="w-4 h-4 text-accent shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            <a href="mailto:info@mktmakina.com" class="hover:text-accent transition-colors">info@mktmakina.com</a>
          </div>
          <div class="flex gap-3">
            <svg class="w-4 h-4 text-accent shrink-0" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.049c.476-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.063 2.063 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
            <a href="https://www.linkedin.com/company/mkt-incorporated/" target="_blank" rel="noopener noreferrer" class="hover:text-accent transition-colors">LinkedIn</a>
          </div>
        </address>
      </div>
    </div>
  </div>

  <!-- Bottom Bar (MTO stili: gradient ayırıcı + Design by) -->
  <div class="container-custom pb-6">
    <div class="h-px bg-gradient-to-r from-transparent via-white/10 to-transparent mt-4 mb-6"></div>
    <div class="flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-white/35">
      <span>&copy; {year} {t(lang, 'company.full')} — {t(lang, 'footer.rights')}</span>
      <div class="flex items-center gap-1.5">
        <span>{l({ tr: 'Design by', en: 'Design by', de: 'Design von', ar: 'تصميم' })}</span>
        <a href="https://erdemozyurt.com" target="_blank" rel="noopener noreferrer" class="text-white/35 hover:text-accent transition-colors duration-300">Erdem Özyurt</a>
        <span class="text-white/15" aria-hidden="true">·</span>
        <a href="https://siberkale.com" target="_blank" rel="noopener noreferrer" class="text-white/35 hover:text-accent transition-colors duration-300">SiberKale</a>
      </div>
    </div>
  </div>
</footer>
