---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CTA from '../components/CTA.astro';
import { references } from '../data/references';
---

<BaseLayout title="Referanslar — MKT Makina A.Ş." description="MKT Makina referansları: HAVELSAN, TUSAŞ, TRMOTOR, ZIM Aircraft Seating, TCI ve daha fazlası." lang="tr" hasHero={false}>
  <PageHero title="Referanslar" subtitle="Güvenilir iş ortaklarımız" image="/images/hero/atolye-perspektif.jpg" />

  <section class="ref-page-section">
    <div class="container-custom max-w-[1000px]">
      <p class="text-center text-white/40 text-base mb-14 max-w-2xl mx-auto" data-animate="fade-up">
        Havacılık, otomotiv, ilaç ve ağır sanayi sektörlerinden güçlü referanslarımızla uzun vadeli iş birlikleri sürdürüyoruz.
      </p>

      <div class="ref-page-grid">
        {references.map((ref, i) => (
          <div class="ref-page-card" data-animate="fade-up" data-delay={String(i * 80)}>
            <img src={ref.image} alt={ref.name} class="ref-page-logo" loading="lazy" />
          </div>
        ))}
      </div>
    </div>
  </section>

  <CTA lang="tr" />
</BaseLayout>

<style>
  .ref-page-section {
    padding-block: 4rem 6rem;
    background: linear-gradient(180deg, var(--color-primary-dark) 0%, var(--color-primary) 100%);
    position: relative;
  }

  .ref-page-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }
  @media (min-width: 640px) {
    .ref-page-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.25rem;
    }
  }

  .ref-page-card {
    aspect-ratio: 4 / 3;
    background: #fff;
    border-radius: 4px;
    overflow: hidden;
    padding: 1.5rem;
    transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }
  .ref-page-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 16px 48px rgba(200, 162, 60, 0.15);
  }

  .ref-page-logo {
    width: 100%;
    height: 100%;
    object-fit: contain;
    opacity: 0.92;
    transition: all 0.4s ease;
  }
  .ref-page-card:hover .ref-page-logo {
    opacity: 1;
  }
</style>
